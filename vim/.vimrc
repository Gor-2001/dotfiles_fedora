" Basic settings
syntax on
set number
set relativenumber
set cursorline

" Indentation
set tabstop=4
set shiftwidth=4
set expandtab
set autoindent
set smartindent

" Search
set hlsearch
set incsearch
set ignorecase
set smartcase

" Visual whitespace
set list
set listchars=tab:→\ ,trail:·,extends:>,precedes:<,nbsp:+

" Performance
set lazyredraw

" Better command-line completion
set wildmenu
set wildmode=longest:full,full

" Don't create backup files
set nobackup
set nowritebackup
set noswapfile

" Mouse support
set mouse=a

" Clipboard (use system clipboard)
set clipboard=unnamedplus

" Better splitting
set splitbelow
set splitright

" Show matching brackets
set showmatch

" File encoding
set encoding=utf-8
set fileencoding=utf-8
